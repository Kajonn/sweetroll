{
  "name": "sweetroll",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:http": "tsx watch src/bootstrap/http.ts",
    "migrate": "tsx src/bootstrap/migrate.ts",
    "start:http": "node dist/bootstrap/http.js",
    "start:migrate": "node dist/bootstrap/migrate.js",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:generate": "tsx scripts/generate-system-contracts.ts",
    "contracts:check": "tsx scripts/generate-system-contracts.ts --check"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "fastify": "5.12.1",
    "fastify-plugin": "5.1.0",
    "json-canonicalize": "3.0.0",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
