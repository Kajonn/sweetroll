  "expressions": [
    {
      "id": "defense_expr",
      "context": "computed",
      "resultType": "number",
      "source": "10 + fields.modifier",
      "fallback": 10
    },
    {
      "id": "check_expr",
      "context": "roll",
      "resultType": "number",
      "source": "d20 + fields.modifier + inputs.bonus",
      "fallback": 0
    },
    {
      "id": "ability_valid_expr",
      "context": "validation",
      "resultType": "boolean",
      "source": "fields.ability >= 3 && fields.ability <= 18",
      "fallback": false
    }
  ],
